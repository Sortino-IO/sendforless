---
import globalCss from "../styles/global.css?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Disclosure from "../components/Disclosure.astro";
import Analytics from "../components/Analytics.astro";
import { CONTACT_EMAIL, SITE_NAME, SITE_URL } from "../lib/site";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  disclosure?: string;
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  ogImage = "/og-default.png",
  noindex = false,
  disclosure,
  jsonLd = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const image = new URL(ogImage, SITE_URL).href;
const skipSuffix = Astro.url.pathname.startsWith("/compare/") || Astro.url.pathname.startsWith("/pricing/");
const fullTitle = skipSuffix || title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE_NAME,
  url: `${SITE_URL}/`,
  logo: `${SITE_URL}/logo.svg`,
  email: CONTACT_EMAIL,
  description:
    "Independent editorial comparisons of newsletter platforms, ranked by what a send actually costs.",
};

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE_NAME,
  url: `${SITE_URL}/`,
  publisher: { "@type": "Organization", name: SITE_NAME, url: `${SITE_URL}/` },
};

const blocks = [organization, website, ...jsonLd];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="google-site-verification" content="M7PES0bHN85Y02FFz1qEPVownQx95WZQmugDgTTswZg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#07070c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch.png" />
    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/space-grotesk-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {blocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block).replace(/</g, "\\u003c")} />
    ))}
    <link rel="stylesheet" href={globalCss} />
    <Analytics />
  </head>
  <body>
    <Analytics placement="body" />
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <Disclosure text={disclosure} />
    <slot />
    <Footer />
  </body>
</html>
