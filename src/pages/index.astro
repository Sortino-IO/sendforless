---
import BaseLayout from "../layouts/BaseLayout.astro";
import Calculator from "../components/Calculator.astro";
import CostChart from "../components/CostChart.astro";
import HeroMark from "../components/HeroMark.astro";
import { guides } from "../lib/guides";
import { mailcheapHref } from "../lib/site";

const homeGuides = [
  "beehiiv-pricing",
  "flodesk-pricing",
  "convertkit-pricing",
  "mailerlite-vs-mailchimp",
  "beehiiv-review",
  "mailcheap-review",
  "how-to-start-a-newsletter",
  "ghost-vs-substack",
].map((slug) => guides.find((guide) => guide.slug === slug)!);

const description =
  "What a weekly newsletter costs on MailCheap, beehiiv, Kit, Ghost, Flodesk, MailerLite, Mailchimp, and Substack. Prices are month-to-month USD list rates checked on 24 November 2026.";
---
<BaseLayout title="Newsletter platform costs, by list size" description={description} ogImage="/og/home.png">
  <main id="main">
    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <p class="kicker"><span class="kicker-dot" aria-hidden="true"></span> Newsletter platforms</p>
          <h1>What your newsletter costs, at your list size</h1>
          <p class="lede">A platform bill is a subscriber bucket, an email cap, or a percent of revenue. Enter your list and how often you send. The calculator maps that onto published month-to-month prices.</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#calculator">Open the calculator</a>
            <a class="btn btn-secondary" href="/compare/mailcheap-vs-beehiiv/">MailCheap vs beehiiv</a>
          </div>
          <div class="platform-row">
            <p class="hint">Start with a price page</p>
            <a class="chip" href="/reviews/mailcheap/"><span class="avatar av-violet">MC</span> MailCheap</a>
            <a class="chip" href="/pricing/beehiiv/"><span class="avatar av-gold">bh</span> beehiiv</a>
            <a class="chip" href="/pricing/convertkit/"><span class="avatar av-green">Kt</span> Kit</a>
            <a class="chip" href="/pricing/flodesk/"><span class="avatar av-teal">Fd</span> Flodesk</a>
            <a class="chip" href="/alternatives/mailchimp/"><span class="avatar av-yellow">Ch</span> Mailchimp</a>
            <a class="chip" href="/alternatives/substack/"><span class="avatar av-orange">Sb</span> Substack</a>
          </div>
        </div>
        <div class="hero-visual">
          <HeroMark variant="home" />
          <div class="chart-card">
            <div class="chart-head">
              <h2>4,000 subscribers, one issue a week</h2>
              <p>Month-to-month list prices. The estimate is about 17,300 emails.</p>
            </div>
            <div class="hero-compare">
              <div class="big-stat">
                <span class="label">MailCheap Starter</span>
                <span class="val grad">$19</span>
                <span class="sub">If the issues fit in 20,000 emails</span>
              </div>
              <div class="vs">vs</div>
              <div class="big-stat">
                <span class="label">beehiiv Lite</span>
                <span class="val">$109</span>
                <span class="sub">Monthly billing, up to 5,000 subscribers</span>
              </div>
            </div>
            <p class="chart-foot">Five weekly issues to 4,000 people are 20,000 emails, before welcome emails and tests. That uses all of Starter. If you send those too, price Growth at $39. Kit and Substack can still be $0 here. Prices checked 24 November 2026.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="calculator" aria-labelledby="calc-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="calc-title">Cost calculator</h2>
          <p>The bars use month-to-month USD list prices. A missing dollar means that vendor does not publish a fixed price for that list size. Those rows are not ranked.</p>
        </div>
        <Calculator />
        <p class="method-note" id="method">
          Prices checked 24 November 2026. The monthly estimate is subscribers times issues per week times 4.33, so a typical month is included. A month with five send weeks is higher, and MailCheap also counts welcome emails and tests. Short promotions are ignored, including Kit’s introductory price on Creator through 1 December 2026. Sources and the figures we do not publish are on <a href="/how-we-test/">How we test</a>.
        </p>

        <CostChart
          title="Monthly cost at 4,000 subscribers, one issue a week"
          description="Verified month-to-month list prices. Kit and Substack are $0. Mailchimp is omitted because its price above 500 contacts is not a published table."
          caption="Mailchimp Standard starts at $20 a month for 500 contacts. For 4,000 contacts, check Mailchimp’s pricing page. Five send weeks at this list size use 20,000 MailCheap emails before welcomes and tests."
          rows={[
            { label: "Kit Free", value: 0, note: "Broadcasts" },
            { label: "Substack", value: 0, note: "No monthly fee" },
            { label: "MailCheap", value: 19, note: "Starter, if emails fit" },
            { label: "Flodesk", value: 46, note: "Email plan, any list size" },
            { label: "MailerLite", value: 49, note: "Comfort, up to 5,000" },
            { label: "Ghost", value: 75, note: "Publisher, up to 5,000" },
            { label: "beehiiv", value: 109, note: "Lite, up to 5,000" },
          ]}
        />

        <div class="section-head" style="margin-top:2.5rem">
          <h2>What changes the bill</h2>
          <p>Same list, one issue a week, about 17,300 emails. The lower number is not always the right product.</p>
        </div>
        <div class="table-wrap">
          <table>
            <caption>Monthly list price at 4,000 subscribers, one issue a week</caption>
            <thead>
              <tr>
                <th scope="col">Platform</th>
                <th scope="col">You pay for</th>
                <th class="num" scope="col">This example</th>
                <th scope="col">Free plan that can send</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Kit</th>
                <td data-label="You pay for">Subscribers, after the free cap or when you need sequences</td>
                <td class="num" data-label="This example"><span class="price">$0</span><span class="price-sub">Free, broadcasts</span></td>
                <td data-label="Free plan">Yes, up to 10,000 subscribers for broadcasts.</td>
              </tr>
              <tr>
                <th scope="row">Substack</th>
                <td data-label="You pay for">10% of paid subscription revenue</td>
                <td class="num" data-label="This example"><span class="price">$0</span><span class="price-sub">Publishing fee</span></td>
                <td data-label="Free plan">Yes. No monthly platform fee.</td>
              </tr>
              <tr>
                <th scope="row">MailCheap</th>
                <td data-label="You pay for">Emails sent, plus a subscriber cap</td>
                <td class="num" data-label="This example"><span class="price">$19</span><span class="price-sub">Starter, with the caveat below</span></td>
                <td data-label="Free plan">No hosted free plan.</td>
              </tr>
              <tr>
                <th scope="row">Flodesk</th>
                <td data-label="You pay for">A flat sending plan</td>
                <td class="num" data-label="This example"><span class="price">$46</span><span class="price-sub">Email, monthly</span></td>
                <td data-label="Free plan">Free does not include sending.</td>
              </tr>
              <tr>
                <th scope="row">MailerLite</th>
                <td data-label="You pay for">Active subscribers, with an email cap on Comfort</td>
                <td class="num" data-label="This example"><span class="price">$49</span><span class="price-sub">Comfort, up to 5,000</span></td>
                <td data-label="Free plan">250 subscribers and 2,500 emails.</td>
              </tr>
              <tr>
                <th scope="row">Ghost(Pro)</th>
                <td data-label="You pay for">Members on the site</td>
                <td class="num" data-label="This example"><span class="price">$75</span><span class="price-sub">Publisher</span></td>
                <td data-label="Free plan">No hosted free plan.</td>
              </tr>
              <tr>
                <th scope="row">beehiiv</th>
                <td data-label="You pay for">Subscribers. Sends are unlimited.</td>
                <td class="num" data-label="This example"><span class="price">$109</span><span class="price-sub">Lite, monthly</span></td>
                <td data-label="Free plan">Yes, up to 2,500 subscribers.</td>
              </tr>
              <tr>
                <th scope="row">Mailchimp</th>
                <td data-label="You pay for">Contacts stored, including unsubscribed</td>
                <td class="num" data-label="This example"><span class="price">Check current pricing</span><span class="price-sub">Standard starts at $20 for 500 contacts</span></td>
                <td data-label="Free plan">250 contacts and 500 sends a month.</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="method-note">At 4,000 subscribers, five weekly issues use all 20,000 emails on MailCheap Starter, before welcome emails and tests. If you also send those, price Growth ($39) before you switch. The MailCheap link in the calculator is an affiliate link (<a href={mailcheapHref("/pricing")} rel="sponsored nofollow noopener" target="_blank">pricing</a>). The other links in the table are not. MailCheap does not include paid subscriptions, an ad network, a referral program, or A/B tests. Kit Free or Substack is the lower cost if either one already does the job.</p>
        <p class="cta-row">
          <a class="btn btn-primary" href={mailcheapHref("/pricing")} rel="sponsored nofollow noopener" target="_blank">See MailCheap pricing</a>
          <a class="btn btn-secondary" href="/reviews/mailcheap/">Read the MailCheap review</a>
          <span class="btn-note">Affiliate link. We may earn a commission. The price you pay does not change.</span>
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="fit-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="fit-title">Which bill matches the job</h2>
          <p>Pick the row that describes the newsletter you actually send.</p>
        </div>
        <div class="table-wrap">
          <table>
            <caption>A starting point, not a ranking</caption>
            <thead>
              <tr>
                <th scope="col">Your situation</th>
                <th scope="col">Look at</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Under 10,000 subscribers, and you only broadcast</th>
                <td data-label="Look at">Kit Free, at $0. <a href="/pricing/convertkit/">Kit pricing</a></td>
              </tr>
              <tr>
                <th scope="row">Under 2,500 subscribers, and you want a site and recommendations</th>
                <td data-label="Look at">beehiiv Free, at $0. <a href="/pricing/beehiiv/">beehiiv pricing</a></td>
              </tr>
              <tr>
                <th scope="row">Readers pay you, and 10% is still smaller than a monthly plan</th>
                <td data-label="Look at">Substack. <a href="/compare/beehiiv-vs-substack/">beehiiv vs Substack</a></td>
              </tr>
              <tr>
                <th scope="row">You send on a schedule, you are past the free caps, and you do not need a paywall inside the tool</th>
                <td data-label="Look at">MailCheap, from $19. <a href="/reviews/mailcheap/">MailCheap review</a></td>
              </tr>
              <tr>
                <th scope="row">You want one price that does not move as the list grows</th>
                <td data-label="Look at">Flodesk Email, $46 a month. <a href="/pricing/flodesk/">Flodesk pricing</a></td>
              </tr>
              <tr>
                <th scope="row">Members log in to a site you theme</th>
                <td data-label="Look at">Ghost(Pro). <a href="/alternatives/ghost/">Ghost alternatives</a></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section" id="guides" aria-labelledby="guides-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="guides-title">Pricing, comparisons, and reviews</h2>
          <p>Grouped under <a href="/alternatives/">alternatives</a>, <a href="/pricing/">pricing</a>, <a href="/compare/">comparisons</a>, <a href="/reviews/">reviews</a>, and <a href="/guides/">guides</a>.</p>
        </div>
        <div class="card-grid">
          {homeGuides.map((guide) => (
            <a class="card article-card" href={guide.href}>
              <p class="kicker">{guide.kicker}</p>
              <h3>{guide.title}</h3>
              <p>{guide.blurb}</p>
              <span class="arrow">Read</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
