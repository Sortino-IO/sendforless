---
import { guidesBySlug, footerGuideSlugs } from "../lib/guides";
import { mailcheapHref } from "../lib/site";

const guideLinks = guidesBySlug(footerGuideSlugs);
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <h2>About this site</h2>
      <p class="fineprint">sendforless is an independent comparison site for newsletter platforms. We are not the official site for MailCheap, beehiiv, Kit, Mailchimp, Ghost, Substack, MailerLite, or Flodesk, and we do not speak for them.</p>
      <p class="fineprint">We may earn a commission if you buy MailCheap through our links. That commission does not change the price you pay, and it does not change how we describe limits or missing features.</p>
    </div>
    <div>
      <h2>Guides</h2>
      <ul>
        {guideLinks.map((guide) => (
          <li><a href={guide.href}>{guide.title}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h2>Method</h2>
      <ul>
        <li><a href="/how-we-test/">How prices are calculated</a></li>
        <li><a href="/#calculator">Cost calculator</a></li>
        <li><a href="/reviews/mailcheap/">MailCheap review</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/affiliate-disclosure/">Affiliate disclosure</a></li>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href={mailcheapHref("/pricing")} rel="sponsored nofollow noopener" target="_blank">MailCheap pricing (affiliate)</a></li>
      </ul>
    </div>
  </div>
</footer>
