---
import {
  DEFAULT_ISSUES,
  DEFAULT_SUBS,
  emailsPerMonth,
  lowestPaid,
  money,
  quote,
  selectRows,
  showLowestBadge,
  sortedRows,
  type QuoteRow,
} from "../lib/pricing";

interface Props {
  platforms?: string[];
  idPrefix?: string;
  /** Adds the MailCheap send-only toggle. Leave off when MailCheap is already one of the two platforms. */
  cheaperToggle?: boolean;
  defaultSubs?: number;
  defaultIssues?: number;
}

const {
  platforms,
  idPrefix = "calc",
  cheaperToggle = false,
  defaultSubs = DEFAULT_SUBS,
  defaultIssues = DEFAULT_ISSUES,
} = Astro.props;

const platformList = platforms && platforms.length ? platforms : null;
const initial = quote(defaultSubs, defaultIssues);
const visible = selectRows(initial.rows, platformList, false);
const cheaperRow = cheaperToggle ? initial.rows.find((row) => row.platform === "MailCheap") : undefined;
const dataPlatforms = platformList ? platformList.join(",") : "";

function barWidth(row: QuoteRow, maxPaid: number) {
  if (row.monthly === null || row.monthly === 0) return 0;
  return Math.max(8, Math.round((row.monthly / maxPaid) * 1000) / 10);
}

function renderRows(rows: QuoteRow[], extraClass = "", allowBadge = true) {
  const badgeOn = allowBadge && showLowestBadge(rows);
  const best = badgeOn ? lowestPaid(rows) : null;
  const paid = rows.filter((item) => typeof item.monthly === "number" && item.monthly > 0);
  const max = paid.length ? Math.max(...paid.map((item) => item.monthly as number)) : 1;
  return rows.map((row) => {
    const isBest = badgeOn && row.priceKind === "known" && row.monthly === best && best !== null;
    const isFree = row.monthly === 0;
    const width = barWidth(row, max);
    return { row, isBest, isFree, width, extraClass };
  });
}

const staticRows = renderRows(sortedRows(visible));
const staticCheaper = cheaperRow ? renderRows(sortedRows([cheaperRow]), "is-cheaper", false) : [];
---

<div
  class="calc-block"
  data-calc
  data-prefix={idPrefix}
  data-platforms={dataPlatforms}
  data-cheaper={cheaperToggle ? "1" : "0"}
  data-default-subs={defaultSubs}
  data-default-issues={defaultIssues}
>
  <div class="calc">
    <form id={`${idPrefix}-form`} action="#results">
      <div class="calc-grid">
        <div class="field">
          <label for={`${idPrefix}-subs`}>Subscribers</label>
          <input id={`${idPrefix}-subs`} name="subs" type="number" inputmode="numeric" min="1" max="500000" step="1" value={defaultSubs} />
          <div class="presets" role="group" aria-label="Subscriber presets">
            <button type="button" class="chip" data-subs="1000">1,000</button>
            <button type="button" class="chip" data-subs="2500">2,500</button>
            <button type="button" class:list={["chip", { "is-active": defaultSubs === 4000 }]} data-subs="4000">4,000</button>
            <button type="button" class="chip" data-subs="10000">10,000</button>
            <button type="button" class="chip" data-subs="25000">25,000</button>
          </div>
        </div>
        <div class="field">
          <label for={`${idPrefix}-issues`}>Issues per week</label>
          <select id={`${idPrefix}-issues`} name="issues">
            <option value="1" selected={defaultIssues === 1}>1 (weekly)</option>
            <option value="2" selected={defaultIssues === 2}>2</option>
            <option value="3" selected={defaultIssues === 3}>3</option>
            <option value="5" selected={defaultIssues === 5}>5 (weekdays)</option>
            <option value="7" selected={defaultIssues === 7}>7 (daily)</option>
          </select>
          <p class="hint">Estimate: subscribers × issues per week × 4.33. A month with five send weeks is higher: 4,000 × 5 = 20,000 emails before welcome emails and tests on MailCheap.</p>
        </div>
      </div>
      {cheaperToggle && (
        <label class="cheaper-toggle">
          <input id={`${idPrefix}-cheaper`} class="cheaper-toggle-input" type="checkbox" />
          <span>Show a cheaper send-only option (MailCheap, affiliate)</span>
        </label>
      )}
      <dl class="calc-summary">
        <div class="stat">
          <dt>List size</dt>
          <dd id={`${idPrefix}-stat-subs`}>{defaultSubs.toLocaleString("en-US")}</dd>
        </div>
        <div class="stat">
          <dt>Cadence</dt>
          <dd id={`${idPrefix}-stat-issues`}>{defaultIssues} {defaultIssues === 1 ? "issue" : "issues"}</dd>
        </div>
        <div class="stat">
          <dt>Emails / month</dt>
          <dd id={`${idPrefix}-stat-emails`}>{emailsPerMonth(defaultSubs, defaultIssues).toLocaleString("en-US")}</dd>
        </div>
      </dl>
    </form>
  </div>

  <p class="results-caption" id={`${idPrefix}-caption`}>
    Estimated monthly platform bill for {defaultSubs.toLocaleString("en-US")} subscribers and {defaultIssues} issue{defaultIssues === 1 ? "" : "s"} a week ({initial.emails.toLocaleString("en-US")} emails a month). Month-to-month USD list prices.
  </p>
  <div class="results" id={`${idPrefix}-bars`} aria-live="polite">
    {[...staticRows, ...staticCheaper].map(({ row, isBest, isFree, width, extraClass }) => (
      <article class:list={["bar-row", extraClass, { "is-best": isBest, "is-free": isFree }]} data-platform={row.platform}>
        <div class="plat">
          <span class:list={["avatar", row.avatar]}>{row.initials}</span>
          <div>
            <strong>{row.platform}</strong>
            <div class="meta">
              <span>{row.plan}</span>
              {row.affiliate && <span class="tag tag-affiliate">Affiliate</span>}
              {isBest && <span class="badge-best">Lowest paid price</span>}
            </div>
          </div>
        </div>
        <div class="bar-track">
          {row.monthly !== null && row.monthly > 0 && <div class="bar-fill" style={`--w:${width}%`}></div>}
        </div>
        <div class="bar-price">
          {row.priceKind === "check" ? "Check current pricing" : row.monthly === null ? "Custom" : <>{money(row.monthly)}<span>/mo</span></>}
        </div>
        <p class="bar-note">
          {row.note}{" "}
          <a href={row.href} rel={row.affiliate ? "sponsored nofollow noopener" : "noopener"} target="_blank">
            {row.affiliate ? "Pricing (affiliate)" : "Official pricing"}
          </a>
        </p>
      </article>
    ))}
  </div>
  {cheaperToggle && (
    <p class="method-note">MailCheap links in this calculator are affiliate links. We may earn a commission. This does not change the price you pay. sendforless is not MailCheap.</p>
  )}
</div>

<script>
  import { lowestPaid, money, quote, selectRows, showLowestBadge, sortedRows } from "../lib/pricing";

  function track(root: HTMLElement, action: string, subs: number, issues: number, cheaper: boolean) {
    const w = window as Window & { dataLayer?: Record<string, unknown>[] };
    const layer = (w.dataLayer = w.dataLayer || []);
    layer.push({
      event: "calculator_interact",
      action,
      subscribers: subs,
      issues_per_week: issues,
      platforms: root.dataset.platforms || "all",
      cheaper_option: cheaper,
      page_path: location.pathname,
    });
  }

  function paint(root: HTMLElement, subs: number, issues: number) {
    const prefix = root.dataset.prefix || "calc";
    const platforms = root.dataset.platforms ? root.dataset.platforms.split(",") : null;
    const cheaperInput = root.querySelector<HTMLInputElement>(`#${prefix}-cheaper`);
    const includeCheaper = Boolean(cheaperInput?.checked);
    const out = quote(subs, issues);
    const rows = sortedRows(selectRows(out.rows, platforms, includeCheaper));
    const emailsEl = root.querySelector<HTMLElement>(`#${prefix}-stat-emails`);
    const subsEl = root.querySelector<HTMLElement>(`#${prefix}-stat-subs`);
    const issuesEl = root.querySelector<HTMLElement>(`#${prefix}-stat-issues`);
    if (emailsEl) emailsEl.textContent = out.emails.toLocaleString("en-US");
    if (subsEl) subsEl.textContent = subs.toLocaleString("en-US");
    if (issuesEl) issuesEl.textContent = issues + (issues === 1 ? " issue" : " issues");

    const caption = root.querySelector<HTMLElement>(`#${prefix}-caption`);
    if (caption) {
      caption.textContent =
        "Estimated monthly platform bill for " +
        subs.toLocaleString("en-US") +
        " subscribers and " +
        issues +
        " issue" +
        (issues === 1 ? "" : "s") +
        " a week (" +
        out.emails.toLocaleString("en-US") +
        " emails a month). Month-to-month USD list prices.";
    }

    const badgeOn = showLowestBadge(rows);
    const best = badgeOn ? lowestPaid(rows) : null;
    const paid = rows.filter((row) => typeof row.monthly === "number" && row.monthly > 0);
    const maxPaid = paid.length ? Math.max(...paid.map((row) => row.monthly as number)) : 1;
    const bars = root.querySelector<HTMLElement>(`#${prefix}-bars`);
    if (!bars) return;
    bars.replaceChildren();

    rows.forEach((row) => {
      const isBest = badgeOn && row.priceKind === "known" && row.monthly === best && best !== null;
      const isFree = row.monthly === 0;
      const article = document.createElement("article");
      article.className = "bar-row" + (isBest ? " is-best" : "") + (isFree ? " is-free" : "");
      article.dataset.platform = row.platform;

      const plat = document.createElement("div");
      plat.className = "plat";
      const avatar = document.createElement("span");
      avatar.className = "avatar " + row.avatar;
      avatar.textContent = row.initials;
      const ident = document.createElement("div");
      const name = document.createElement("strong");
      name.textContent = row.platform;
      const meta = document.createElement("div");
      meta.className = "meta";
      const plan = document.createElement("span");
      plan.textContent = row.plan;
      meta.appendChild(plan);
      if (row.affiliate) {
        const tag = document.createElement("span");
        tag.className = "tag tag-affiliate";
        tag.textContent = "Affiliate";
        meta.appendChild(tag);
      }
      if (isBest) {
        const badge = document.createElement("span");
        badge.className = "badge-best";
        badge.textContent = "Lowest paid price";
        meta.appendChild(badge);
      }
      ident.append(name, meta);
      plat.append(avatar, ident);

      const track = document.createElement("div");
      track.className = "bar-track";
      if (typeof row.monthly === "number" && row.monthly > 0) {
        const fill = document.createElement("div");
        fill.className = "bar-fill";
        const pct = Math.max(8, Math.round((row.monthly / maxPaid) * 1000) / 10);
        fill.style.setProperty("--w", pct + "%");
        track.appendChild(fill);
      }

      const price = document.createElement("div");
      price.className = "bar-price";
      if (row.priceKind === "check") {
        price.textContent = "Check current pricing";
      } else if (row.monthly === null) {
        price.textContent = "Custom";
      } else {
        price.append(document.createTextNode(money(row.monthly)));
        const unit = document.createElement("span");
        unit.textContent = "/mo";
        price.appendChild(unit);
      }

      const note = document.createElement("p");
      note.className = "bar-note";
      note.append(document.createTextNode(row.note + " "));
      const link = document.createElement("a");
      link.href = row.href;
      link.rel = row.affiliate ? "sponsored nofollow noopener" : "noopener";
      link.target = "_blank";
      link.textContent = row.affiliate ? "Pricing (affiliate)" : "Official pricing";
      note.appendChild(link);

      article.append(plat, track, price, note);
      bars.appendChild(article);
    });
  }

  function read(root: HTMLElement) {
    const prefix = root.dataset.prefix || "calc";
    const subsInput = root.querySelector<HTMLInputElement>(`#${prefix}-subs`);
    const issuesInput = root.querySelector<HTMLSelectElement>(`#${prefix}-issues`);
    let subs = parseInt(subsInput?.value || "1", 10);
    let issues = parseInt(issuesInput?.value || "1", 10);
    if (!subs || subs < 1) subs = 1;
    if (!issues || issues < 1) issues = 1;
    return { subs, issues };
  }

  function bind(root: HTMLElement) {
    if (root.dataset.bound === "1") return;
    root.dataset.bound = "1";
    const prefix = root.dataset.prefix || "calc";
    const form = root.querySelector<HTMLFormElement>(`#${prefix}-form`);
    if (!form) return;
    let timer = 0;
    const run = (action: string) => {
      const values = read(root);
      root.querySelectorAll<HTMLButtonElement>("[data-subs]").forEach((btn) => {
        btn.classList.toggle("is-active", parseInt(btn.getAttribute("data-subs") || "0", 10) === values.subs);
      });
      const cheaper = Boolean(root.querySelector<HTMLInputElement>(`#${prefix}-cheaper`)?.checked);
      paint(root, values.subs, values.issues);
      track(root, action, values.subs, values.issues, cheaper);
    };
    form.addEventListener("input", (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.id === `${prefix}-cheaper`) return;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => run("change"), 400);
    });
    form.addEventListener("change", (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.id === `${prefix}-cheaper`) {
        run("cheaper_toggle");
        return;
      }
      window.clearTimeout(timer);
      run("change");
    });
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      window.clearTimeout(timer);
      run("change");
    });
    root.querySelectorAll<HTMLButtonElement>("[data-subs]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const input = root.querySelector<HTMLInputElement>(`#${prefix}-subs`);
        if (input) input.value = btn.getAttribute("data-subs") || input.value;
        window.clearTimeout(timer);
        run("preset");
      });
    });
    root.addEventListener("click", (event) => {
      const node = event.target as HTMLElement | null;
      const link = node?.closest?.("a");
      if (!link?.href) return;
      let host = "";
      try {
        host = new URL(link.href).hostname.toLowerCase();
      } catch {
        return;
      }
      if (host !== "mailcheap.ai" && !host.endsWith(".mailcheap.ai")) return;
      const values = read(root);
      const cheaper = Boolean(root.querySelector<HTMLInputElement>(`#${prefix}-cheaper`)?.checked);
      track(root, "affiliate_link", values.subs, values.issues, cheaper);
    });
  }

  document.querySelectorAll<HTMLElement>("[data-calc]").forEach(bind);
</script>
