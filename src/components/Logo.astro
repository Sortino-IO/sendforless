---
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width={size} height={size} aria-hidden="true">
  <defs>
    <linearGradient id="sfl-logo" x1="4" y1="2" x2="28" y2="30" gradientUnits="userSpaceOnUse">
      <stop stop-color="#A78BFA"></stop>
      <stop offset="0.55" stop-color="#818CF8"></stop>
      <stop offset="1" stop-color="#22D3EE"></stop>
    </linearGradient>
  </defs>
  <rect x="1.25" y="1.25" width="29.5" height="29.5" rx="8" fill="#16162A" stroke="url(#sfl-logo)" stroke-width="1.5"></rect>
  <path d="M8.2 16.2 23.6 8.6c.55-.27 1.1.3.86.86L16.85 23.8c-.28.57-1.1.5-1.27-.12l-1.7-6.06-6.06-1.7c-.62-.17-.7-1 .38-1.28Z" fill="url(#sfl-logo)"></path>
  <path d="M14.3 16.7 23.2 9.9" stroke="#16162A" stroke-width="1.35" stroke-linecap="round"></path>
</svg>
