---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  name: string;
  alt: string;
  caption: string;
}

const { name, alt, caption } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/screenshots/*.webp", { eager: true });
const entry = Object.entries(images).find(([path]) => path.endsWith(`/${name}.webp`));
const src = entry?.[1].default;
---
{src && (
  <figure class="shot">
    <Image
      src={src}
      alt={alt}
      widths={[720, 1100, 1400]}
      sizes="(min-width: 900px) 42rem, 100vw"
      loading="lazy"
      decoding="async"
      format="webp"
    />
    <figcaption>{caption}</figcaption>
  </figure>
)}
