---
import { GA_MEASUREMENT_ID, GTM_ID } from "../lib/site";
import { consentBootSource, gtagConfigSource, gtmBootSource } from "../lib/head-scripts";

interface Props {
  placement?: "head" | "body";
}

const { placement = "head" } = Astro.props;
const useGtm = GTM_ID.length > 0;
---
{placement === "head" && <script is:inline set:html={consentBootSource()}></script>}
{placement === "head" && useGtm && <script is:inline set:html={gtmBootSource()}></script>}
{placement === "head" && !useGtm && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
    <script is:inline set:html={gtagConfigSource()}></script>
  </>
)}
{placement === "body" && useGtm && (
  <noscript>
    <iframe
      class="gtm-noscript"
      src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
      height="0"
      width="0"
      title="Google Tag Manager"></iframe>
  </noscript>
)}
