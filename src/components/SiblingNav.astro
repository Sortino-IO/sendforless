    { href: "/compare/", label: "Newsletter platform comparisons", note: "Pairs at 4,000 subscribers" },
  ],
  "/reviews/beehiiv/": [
    { href: "/pricing/beehiiv/", label: "beehiiv pricing", note: "Free, Lite, and Pro" },
    { href: "/alternatives/beehiiv/", label: "beehiiv alternatives", note: "Cheaper options compared" },
    { href: "/compare/beehiiv-vs-substack/", label: "beehiiv vs Substack", note: "The 10% fee against Lite" },
    { href: "/compare/mailcheap-vs-beehiiv/", label: "MailCheap vs beehiiv", note: "Switching from beehiiv" },
  ],
  "/reviews/mailcheap/": [
    { href: "/compare/mailcheap-vs-beehiiv/", label: "MailCheap vs beehiiv", note: "Starter against Lite" },
    { href: "/alternatives/beehiiv/", label: "beehiiv alternatives", note: "When Lite is the wrong bill" },
    { href: "/pricing/beehiiv/", label: "beehiiv pricing", note: "The buckets MailCheap is priced against" },
  ],
  "/reviews/mailerlite/": [
    { href: "/pricing/mailerlite/", label: "MailerLite pricing", note: "Every Comfort and Power tier" },
    { href: "/alternatives/mailerlite/", label: "MailerLite alternatives", note: "Cheaper options compared" },
    { href: "/compare/mailerlite-vs-mailchimp/", label: "MailerLite vs Mailchimp", note: "Comfort against Essentials and Standard" },
  ],
