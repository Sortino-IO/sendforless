  ],
  "/pricing/flodesk/": [
    { href: "/compare/flodesk-vs-mailchimp/", label: "Flodesk vs Mailchimp", note: "A flat price against contact tiers" },
    { href: "/alternatives/mailchimp/", label: "Mailchimp alternatives", note: "Other exits from a contact bill" },
    { href: "/pricing/mailchimp/", label: "Mailchimp pricing", note: "Free, Essentials, and Standard" },
  ],
  "/pricing/ghost/": [
    { href: "/alternatives/ghost/", label: "Ghost alternatives", note: "When you do not need a membership site" },
    { href: "/compare/ghost-vs-substack/", label: "Ghost vs Substack", note: "Publisher against the 10% fee" },
    { href: "/pricing/substack/", label: "Substack pricing", note: "The 10% fee and the $0 plan" },
  ],
  "/pricing/mailchimp/": [
    { href: "/alternatives/mailchimp/", label: "Mailchimp alternatives", note: "Cheaper options by list size" },
    { href: "/compare/mailerlite-vs-mailchimp/", label: "MailerLite vs Mailchimp", note: "Comfort from $12, Essentials from $13" },
    { href: "/compare/flodesk-vs-mailchimp/", label: "Flodesk vs Mailchimp", note: "A flat price against contact tiers" },
    { href: "/compare/convertkit-vs-mailchimp/", label: "Kit (ConvertKit) vs Mailchimp", note: "Free to 10,000 subscribers" },
  ],
  "/pricing/mailerlite/": [
    { href: "/alternatives/mailerlite/", label: "MailerLite alternatives", note: "Cheaper options compared" },
    { href: "/reviews/mailerlite/", label: "MailerLite review", note: "Who Comfort and Power fit" },
    { href: "/compare/mailerlite-vs-mailchimp/", label: "MailerLite vs Mailchimp", note: "Prices, automations, and sites" },
  ],
  "/pricing/substack/": [
    { href: "/alternatives/substack/", label: "Substack alternatives", note: "Platforms without the 10% fee" },
