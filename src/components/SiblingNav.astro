    { href: "/compare/beehiiv-vs-substack/", label: "beehiiv vs Substack", note: "The bucket price against the 10% fee" },
    { href: "/compare/beehiiv-vs-convertkit/", label: "beehiiv vs Kit (ConvertKit)", note: "Recommendations against sequences" },
    { href: "/compare/mailcheap-vs-beehiiv/", label: "MailCheap vs beehiiv", note: "A counted send against Lite" },
