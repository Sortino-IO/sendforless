    { href: "/pricing/mailchimp/", label: "Mailchimp pricing", note: "Free, Essentials, Standard, and Premium" },
    { href: "/alternatives/mailchimp/", label: "Mailchimp alternatives", note: "Cheaper options by list size" },
    { href: "/compare/mailerlite-vs-mailchimp/", label: "MailerLite vs Mailchimp", note: "Comfort against Essentials and Standard" },
    { href: "/compare/constant-contact-vs-mailchimp/", label: "Constant Contact vs Mailchimp", note: "Two contact bills" },
    { href: "/compare/convertkit-vs-mailchimp/", label: "Kit (ConvertKit) vs Mailchimp", note: "Free broadcasts to 10,000" },
  ],
};

const pricingPage = path.startsWith("/pricing/");
const reviewPage = path.startsWith("/reviews/");
const siblings = pricingPage ? pricing : reviewPage ? reviews : [];
const others = siblings.filter((item) => item.href !== path);
const extra = related[path] ?? [];
const siblingHeading = pricingPage ? "Other pricing pages" : "Other reviews";
const extraHeading = pricingPage ? "Alternatives and comparisons" : "Pricing, alternatives, and comparisons";
---

{(others.length > 0 || extra.length > 0) && (
  <div class="related sibling-nav">
    {others.length > 0 && (
      <div>
        <h2>{siblingHeading}</h2>
        <div class="related-grid">
          {others.map((item) => (
            <a class="card" href={item.href}>
              <strong>{item.label}</strong>
              <p>{item.note}</p>
            </a>
          ))}
        </div>
      </div>
    )}
    {extra.length > 0 && (
      <div>
        <h2>{extraHeading}</h2>
        <div class="related-grid">
          {extra.map((item) => (
            <a class="card" href={item.href}>
              <strong>{item.label}</strong>
              <p>{item.note}</p>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
)}
