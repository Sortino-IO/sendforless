  { href: "/pricing/mailchimp/", label: "Mailchimp pricing", note: "Free, Essentials, Standard, Premium" },
  { href: "/pricing/mailerlite/", label: "MailerLite pricing", note: "Free, Comfort, and Power" },
  { href: "/pricing/substack/", label: "Substack pricing", note: "The 10% fee and the $0 plan" },
];

const reviews: Item[] = [
